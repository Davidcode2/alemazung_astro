<button
  id="testing-theme-switcher"
  class="p-2 rounded-full bg-(--ultralight-accent) hover:bg-(--light-accent) transition cursor-pointer"
  aria-label="Current theme: light. Click to cycle themes."
  title="Theme: light"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-(--grey-accent)"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 22a10 10 0 1 1 10-10c0 1.7-1.3 3-3 3h-1.8c-.7 0-1.2.5-1.2 1.2 0 .3.1.6.3.8.2.3.3.6.3 1A4 4 0 0 1 12 22z"/></svg>
</button>

<script>
  const button = document.getElementById("testing-theme-switcher");
  const themes = ["light", "dark", "blue-light", "blue-dark"];

  function updateLabel(theme: string) {
    button?.setAttribute("aria-label", `Current theme: ${theme}. Click to cycle themes.`);
    button?.setAttribute("title", `Theme: ${theme}`);
  }

  updateLabel(document.documentElement.dataset.theme || "light");
  button?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme || "light";
    const next = themes[(themes.indexOf(current) + 1) % themes.length];
    document.documentElement.dataset.theme = next;
    updateLabel(next);
  });
</script>
