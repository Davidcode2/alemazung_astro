---
import StrapiRichText from "@/components/post/StrapiRichText.astro";
import { t } from "@/lib/i18n";

interface Props {
  content: any;
  locale: string;
}

const { content, locale } = Astro.props;
---

<div class="pb-40 lg:pt-28">
  <div class="flex flex-col xl:grid xl:grid-cols-[60%_40%] lg:gap-x-10 mx-10 lg:mx-20 xl:mx-60 2xl:mx-90">
    <div class="order-2 xl:order-1 z-30">
      <section class="z-30 lg:text-2xl">
        <StrapiRichText content={content} className="leading-7 lg:leading-12" />
      </section>
    </div>
    <div class="py-8 md:py-14 xl:py-0 order-1 xl:order-2 z-10 opacity-20 font-extrabold text-4xl md:text-7xl lg:text-7xl text-(--accent)">
      <div class="font-serif">
        {t("localResponsibilityGlobalPerspective", locale)}
      </div>
    </div>
  </div>

  <div class="pt-32 flex justify-center gap-x-5 md:gap-x-20">
    <img
      src="/images/cdu_logo.svg"
      alt="CDU Logo"
      class="w-32 lg:w-60"
    />
    <img
      src="/images/he_for_she_logo.svg"
      alt="He for She Logo"
      class="w-32 lg:w-60"
    />
  </div>
</div>
