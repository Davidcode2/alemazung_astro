---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<div
  class="w-full h-[60vh] bg-cover bg-top"
  style={`background-image: url(${url})`}
>
  <div class="h-full grid grid-cols-12 grid-rows-12">
    <div class="col-start-2 col-span-4 row-start-6 md:row-start-8">
      <slot />
    </div>
  </div>
</div>
