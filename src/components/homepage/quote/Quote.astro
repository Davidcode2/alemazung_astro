---
interface QuoteData {
  quoteText: string;
  author: string;
  backgroundColor: string;
}

interface Props {
  data: QuoteData;
}

const { data } = Astro.props;
---

<div class="bg-(--ultralight-accent) py-50 lg:py-80 w-full">
  <div class="lg:w-2/3 mx-auto text-(--dark-accent) dark:text-foreground">
    <div class="flex px-6">
      <span class="content-center text-8xl font-serif mr-8 leading-none">
        "
      </span>
      <blockquote class="flex text-center items-center justify-center italic text-3xl/15 sm:text-4xl/20 lg:text-6xl/20 my-0 p-0">
        <span class="font-serif">
          {data.quoteText}
        </span>
      </blockquote>
      <span class="content-center text-8xl font-serif ml-4 leading-none">
        "
      </span>
    </div>
    <div class="mt-6 text-center">
      {data.author}
    </div>
  </div>
</div>
